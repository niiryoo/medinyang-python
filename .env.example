# 이 파일을 .env 로 복사한 뒤 값을 채운다. .env 는 커밋되지 않는다.
#   cp .env.example .env

# ===== 필수 =====
OPENAI_API_KEY=sk-

# ===== 선택: LangSmith 트레이싱 =====
# 미설정 시 트레이싱만 비활성화되고 서버는 정상 기동
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=medinyang
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ===== 서버 런타임 (config.py) =====
# 인덱스와 임베딩 모델은 반드시 함께 교체. 불일치 시 예외 없이 오답
#   db_ada     + text-embedding-ada-002   (논문 baseline)
#   db_3small  + text-embedding-3-small   (채택, ADR-001)
DB_PATH=db_3small
EMBEDDING_MODEL_NAME=text-embedding-3-small

# 의도 분류기. scripts/train_intent.py 산출물이며 파일이 없으면 필터 없이 동작
INTENT_MODEL_PATH=models/intent.joblib

# 의도가 코퍼스의 약 1/11 - 필터 후 후보를 채우려면 넉넉해야 함
INTENT_FETCH_K=8000

# 재순위화. 1이면 활성 (ADR-007: 이득 구분불가, CPU 질의당 14초)
USE_RERANKER=0

# LLM에 넘기는 최대 대화 턴 수
MAX_HISTORY_TURNS=10

# 이미지 분석 모델
IMAGE_MODEL_NAME=gpt-4o

# ===== 인덱스 빌드 (scripts/preprocess.py, scripts/make_db.py) =====
# AI Hub 「초거대AI 사전학습용 헬스케어 질의응답 데이터」 라벨링 zip 경로
SRC_ZIP=C:/Users/.../Training/02.라벨링데이터/TL.zip

# zip 내부 답변 경로 접두어
SRC_PREFIX=2.답변/감염성질환/

OUT_JSONL=data/answers.jsonl
SRC_JSONL=data/answers.jsonl
DB_OUT=db_3small
EMBEDDING_MODEL=text-embedding-3-small

# 배치 간 대기(초). API 티어의 TPM에 맞춰 조정
#   TPM 1M -> 12,  TPM 5M -> 2
EMBED_DELAY_SECONDS=12

# ===== 골든셋 / 의도 분류기 (scripts/build_goldenset.py, scripts/train_intent.py) =====
# zip 내부 질문 경로 접두어
Q_PREFIX=1.질문/감염성질환/

OUT_GOLDEN=data/goldenset.jsonl
INTENT_MODEL=models/intent.joblib

# 골든셋 의도당 표본 수 (11종 x 20 = 220)
PER_INTENTION=20

# 분류기 학습 의도당 상한. 최다 클래스가 13,673건이라 12,000이면 사실상 전량
TRAIN_PER_INTENTION=12000

SEED=42
