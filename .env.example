# 이 파일을 .env 로 복사한 뒤 값을 채운다. .env 는 커밋되지 않는다.
#   cp .env.example .env

# --- 필수 ---
OPENAI_API_KEY=sk-

# --- 선택: LangSmith 트레이싱 ---
# 미설정 시 트레이싱만 비활성화되고 서버는 정상 기동한다.
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=medinyang

# --- 선택: 인덱스 빌드 설정 (make_db.py) ---
# 답변 JSON 경로. 질문 파일(HC-Q-*)이 섞이면 jq 스키마가 깨진다.
ANSWER_DIR=./data/answers/

# 임베딩 모델. 미지정 시 라이브러리 기본값에 묶이므로 명시한다.
#   text-embedding-ada-002   (논문 baseline)
#   text-embedding-3-small   (약 1/5 비용, 성능 우위)
EMBEDDING_MODEL=text-embedding-ada-002

# 인덱스 출력 경로. 모델별로 분리해 비교 측정한다.
DB_OUT=db

# 배치 간 대기(초). API 티어의 TPM에 맞춰 조정한다.
#   TPM 1M  -> 12
#   TPM 5M  -> 2
EMBED_DELAY_SECONDS=12
